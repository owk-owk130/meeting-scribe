{
  "type": "object",
  "properties": {
    "title": { "type": "string", "description": "会議内容が分かる簡潔な日本語タイトル。30文字以内" },
    "tags": { "type": "array", "items": { "type": "string" }, "description": "内容を表すタグ 2〜4 個" },
    "summary": { "type": "string", "description": "議論の概要。段落を分けた散文" },
    "topics": { "type": "array", "items": { "type": "string" }, "description": "主な論点" },
    "actions": { "type": "array", "items": { "type": "string" }, "description": "決定事項とアクションアイテム" },
    "carried_over": { "type": "array", "items": { "type": "string" }, "description": "関連する過去ノートのアクションの、この会議時点での状況" },
    "related_notes": { "type": "array", "items": { "type": "string" }, "description": "同じ案件・テーマの過去ノートのファイル名（拡張子なし）" },
    "speakers": {
      "type": "array",
      "description": "話者ラベルごとの推定名",
      "items": {
        "type": "object",
        "properties": {
          "label": { "type": "string", "description": "文字起こし中の話者ラベル。例: 話者A、相手B" },
          "name": { "type": "string", "description": "推定した名前" }
        },
        "required": ["label", "name"],
        "additionalProperties": false
      }
    },
    "corrections": {
      "type": "array",
      "description": "文字起こしで誤認識された固有名詞・専門用語の訂正表",
      "items": {
        "type": "object",
        "properties": {
          "from": { "type": "string", "description": "文字起こしに現れる誤った表記そのまま" },
          "to": { "type": "string", "description": "正しい表記" }
        },
        "required": ["from", "to"],
        "additionalProperties": false
      }
    }
  },
  "required": ["title", "tags", "summary", "topics", "actions", "carried_over", "related_notes", "speakers", "corrections"],
  "additionalProperties": false
}
